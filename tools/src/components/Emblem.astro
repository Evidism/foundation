---
/**
 * The emblem as described in 12-emblem.md: a lowercase e inside an open
 * ring, with a single point set into the opening at the top.
 */
interface Props {
  size?: number | string;
  title?: string;
  class?: string;
}
const { size = 48, title = 'The emblem of Evidism', class: className } = Astro.props;
---
<svg
  class:list={['emblem', className]}
  viewBox="0 0 100 100"
  width={size}
  height={size}
  role="img"
  aria-label={title}
  fill="none"
  stroke="currentColor"
  stroke-width="7"
  stroke-linecap="round"
>
  <path d="M63.29 9.1A43 43 0 1 1 36.71 9.1" />
  <path d="M74 50A24 24 0 1 0 68.39 65.43M26 50H74" />
  <circle cx="50" cy="7" r="6.5" fill="var(--accent)" stroke="none" />
</svg>
